# Copy to .env and edit. Never commit .env.
# OBS > Tools > WebSocket Server Settings: enable, set a password, put it here.
FESTCAST_OBS_PASSWORD=
FESTCAST_OBS_HOST=127.0.0.1
FESTCAST_OBS_PORT=4455
# Password for controlling FestCast from another device on the LAN (empty = only this PC can control it)
FESTCAST_ADMIN_PASSWORD=
# Run without OBS using an in-memory simulator (clearly labelled SIMULATION in the UI)
FESTCAST_SIMULATION=false
FESTCAST_PORT=8420
# Override the address phones/TVs use if auto-detection picks the wrong network adapter
FESTCAST_PUBLIC_HOST=
FESTCAST_INVITE_TTL_HOURS=48
